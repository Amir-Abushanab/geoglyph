{
  "name": "geoglyph",
  "version": "0.1.0",
  "description": "Every country as a mark the size of a letter: an SVG outline cropped to the landmass people recognise, and its flag to pour inside.",
  "keywords": [
    "country",
    "countries",
    "silhouette",
    "outline",
    "shape",
    "glyph",
    "icon",
    "svg",
    "flag",
    "flags",
    "iso-3166",
    "natural-earth",
    "map"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "generated",
    "llms.txt",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./svg": {
      "types": "./dist/svg.d.ts",
      "default": "./dist/svg.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./flags": {
      "types": "./dist/flags.d.ts",
      "default": "./dist/flags.js"
    },
    "./flags-svg": {
      "types": "./dist/flags-svg.d.ts",
      "default": "./dist/flags-svg.js"
    },
    "./shape/*": {
      "types": "./generated/shape.d.ts",
      "default": "./generated/shape/*.js"
    },
    "./flag/*": {
      "types": "./generated/flag.d.ts",
      "default": "./generated/flag/*.js"
    },
    "./flag-px/*": {
      "types": "./generated/flag-px.d.ts",
      "default": "./generated/flag-px/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint",
    "fmt": "oxfmt src test scripts",
    "fmt:check": "oxfmt --check src test scripts",
    "dev": "node scripts/dev.mjs",
    "vendor": "node scripts/build-shapes.mjs && node scripts/build-flags.mjs",
    "sheet": "pnpm build && node scripts/contact-sheet.mjs",
    "banner": "pnpm build && node scripts/build-banner.mjs",
    "llms": "node scripts/build-llms.mjs",
    "site": "pnpm build && node scripts/build-banner.mjs && pnpm llms && node scripts/build-site.mjs",
    "test": "node --test 'test/*.test.ts'",
    "check": "pnpm build && tsc --noEmit && pnpm lint && pnpm fmt:check && node scripts/build-llms.mjs --check && pnpm test && publint && attw --pack . --ignore-rules no-resolution cjs-resolves-to-esm",
    "version-packages": "changeset version && pnpm llms",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
